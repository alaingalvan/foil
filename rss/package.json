{
  "name": "@foil-cms/rss",
  "version": "0.6.0",
  "description": "Generate a Foil RSS feed from the post database and statically rendered React posts.",
  "author": "Alain Galvan <hi@alain.xyz>",
  "license": "SEE LICENSE IN ../license.md",
  "type": "module",
  "source": "src/main.ts",
  "main": "dist/main.js",
  "exports": "./dist/main.js",
  "bin": {
    "foil-rss": "dist/main.js"
  },
  "scripts": {
    "start": "esbuild src/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/main.js",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaingalvan/foil.git"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "pg": "^8.23.1",
    "systemjs": "=6.15.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.x",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
