{
  "name": "@foil-cms/builder",
  "version": "1.1.0",
  "description": "✨ Foil's package builder, bundle your application runtime or build foil libraries.",
  "author": "Alain Galvan <hi@alain.xyz>",
  "license": "SEE LICENSE IN ../../license.md",
  "type": "module",
  "typings": "dist/src/foil-builder.d.ts",
  "types": "dist/src/foil-builder.d.ts",
  "source": "src/foil-builder.ts",
  "main": "dist/src/foil-builder.js",
  "module": "dist/src/foil-builder.js",
  "exports": "./dist/src/foil-builder.js",
  "scripts": {
    "start": "esbuild src/foil-builder.ts --bundle --platform=node --target=node24 --format=esm --packages=external --sourcemap --outfile=dist/src/foil-builder.js && tsx ./post-build.ts",
    "check": "tsc --noEmit"
  },
  "bin": {
    "foil-builder": "dist/src/foil-builder.js"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaingalvan/foil.git"
  },
  "files": [
    "src"
  ],
  "keywords": [
    "systemjs",
    "typescript",
    "postcss"
  ],
  "devDependencies": {
    "@mdx-js/react": "^3.1.1",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/node": "^26.6.x",
    "@types/react": "^19.3.x",
    "@types/react-dom": "^19.3.x",
    "@types/react-redux": "^7.1.x",
    "@types/react-router": "^5.1.x",
    "@types/webpack": "^5.28.5",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@mdx-js/react": ">=2.3.0",
    "react": ">=18.3",
    "react-dom": ">=18.3",
    "react-router": "^8.4.0",
    "systemjs": "=6.15.1"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "acorn": "^8.19.0",
    "acorn-jsx": "^5.3.2",
    "autoprefixer": "^10.7.0",
    "chalk": "6.0.1",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "esbuild-loader": "^4.5.0",
    "file-loader": "^6.2.0",
    "highlight.js": "^11.12.0",
    "mdast-util-mdx": "^3.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "path-browserify": "^1.0.1",
    "postcss-advanced-variables": "^5.0.0",
    "postcss-loader": "8.2.2",
    "postcss-nested": "^9.0.1",
    "postcss-preset-env": "^11.6.3",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.18.2",
    "string-replace-loader": "^3.3.0",
    "style-loader": "^4.0.0",
    "systemjs": "=6.15.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "webpack": "5.113.0"
  }
}
